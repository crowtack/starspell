{
  "name": "@starspell/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "start": "node --env-file=.env dist/src/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/platform-socket.io": "^12.6.2",
    "@nestjs/websockets": "^12.6.2",
    "@prisma/client": "^6.19.0",
    "@starspell/shared": "workspace:*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
